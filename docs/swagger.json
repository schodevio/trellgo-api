{
    "swagger": "2.0",
    "info": {
        "description": "REST API for a Trello-like app.",
        "title": "TrellGo API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:3000",
    "basePath": "/api/v1",
    "paths": {
